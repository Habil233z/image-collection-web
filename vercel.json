{
  "version": 2,
  "builds": [
    {
      "src": "image-web-backend/main.go",
      "use": "@vercel/go"
    },
    {
      "src": "image-web-frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "functions": {
    "image-web-backend/api/**": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/login/?",
      "dest": "/image-web-backend/main.go",
      "methods": ["GET", "POST", "OPTIONS"]
    },
    {
      "src": "/register/?",
      "dest": "/image-web-backend/main.go",
      "methods": ["GET", "POST", "OPTIONS"]
    },
    {
      "src": "/logout/?",
      "dest": "/image-web-backend/main.go",
      "methods": ["GET", "POST", "OPTIONS"]
    },
    {
      "src": "/api/(.*)",
      "dest": "/image-web-backend/main.go"
    },
    {
      "src": "/(.*)",
      "dest": "/image-web-frontend/$1"
    }
  ]
}