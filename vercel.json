{
  "version": 2,
  "functions": {
    "image-web-backend/main.go": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/login/?",
      "dest": "/image-web-backend/main.go",
      "methods": ["GET", "POST", "OPTIONS"]
    },
    {
      "src": "/register/?",
      "dest": "/image-web-backend/main.go",
      "methods": ["GET", "POST", "OPTIONS"]
    },
    {
      "src": "/logout/?",
      "dest": "/image-web-backend/main.go",
      "methods": ["GET", "POST", "OPTIONS"]
    },
    {
      "src": "/api/(.*)",
      "dest": "/image-web-backend/main.go"
    },
    {
      "src": "/(.*)",
      "dest": "/image-web-frontend/$1"
    }
  ]
}